# backend/.env.example
# Copy to backend/.env and fill in real values. Do NOT commit backend/.env.

# --- Neon / PostgreSQL ------------------------------------------------------
# Connection string from the Neon dashboard (production branch, pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional: max pool connections (default 10)
# PG_POOL_MAX=10

# --- Existing server config -------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
PORT=8001
# AUDIVERIS_CLI="C:\\Program Files\\Audiveris\\Audiveris.exe"
